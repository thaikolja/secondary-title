# EditorConfig: https://EditorConfig.org
# Top-most EditorConfig file: applied to all files unless overridden.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false

[*.{json,yml,yaml,md,twig,xml,svg,css,scss,js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.twig]
trim_trailing_whitespace = false
