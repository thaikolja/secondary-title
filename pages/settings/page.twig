{# Settings page — vertical split: settings left, decorative preview panel right. #}
<div class="st-settings">

	<div class="st-header">
		<div class="st-header__text">
			<h1 class="wp-heading-inline">{{ page.heading|e }}</h1>
			<p class="st-tagline">{{ __('Add a secondary title to posts, pages, and custom post types.', 'secondary-title') }}</p>
		</div>
	</div>

	<form method="post" action="options.php" novalidate>
		{{ settings_fields(page.option_group)|raw }}

		<div class="st-split">
			<div class="st-main">
				{% include 'settings/sections/general.twig' %}
			</div>

			<aside class="st-panel">
				{% include 'settings/sections/preview-panel.twig' %}
				{% include 'settings/sections/donation.twig' %}
			</aside>
		</div>

		{% include 'partials/save-bar.twig' with { labels } only %}
	</form>
</div>
