{# Settings page — hero title format + micro card grid. #}
<div class="st-settings">

	<div class="st-hero">
		<div class="st-hero__text">
			<h1 class="wp-heading-inline">{{ page.heading|e }}</h1>
			<p class="st-tagline">{{ __('Add a secondary title to posts, pages, and custom post types.', 'secondary-title') }}</p>
		</div>
		<a href="https://docs.kolja-nolte.com/secondary-title/"
		   class="st-hero__link"
		   target="_blank"
		   rel="noopener noreferrer">
			{% include 'components/icon.twig' with { name: 'book-open', size: 16 } only %}
			<span>{{ __('Documentation', 'secondary-title') }}</span>
		</a>
	</div>

	<form method="post" action="options.php" novalidate>
		{{ settings_fields(page.option_group)|raw }}

		{% include 'settings/sections/general.twig' %}

		{% include 'settings/sections/info-row.twig' %}

		{% include 'partials/save-bar.twig' with { labels } only %}
	</form>
</div>
