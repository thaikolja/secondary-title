{# General settings — title format (full-width) + toggles (2-col grid). #}

<div class="st-grid">

	{# Title Format — always full width #}
	{% embed 'components/card.twig' with { title: __('Title format', 'secondary-title'), icon: 'paint-brush', id: 'st-card-format' } %}
		{% block card_body %}
			{% include 'fields/format-with-preview.twig' with { name: keys.title_format, id: 'st-field-title-format', value: settings[keys.title_format], preview_id: 'st-format-preview' } %}
		{% endblock %}
	{% endembed %}

	{# Auto Merge #}
	{% embed 'components/card.twig' with { title: __('Auto merge', 'secondary-title'), icon: 'wand', id: 'st-card-auto-merge' } %}
		{% block card_body %}
			{% include 'components/toggle.twig' with { name: keys.auto_show, id: 'st-toggle-auto-show', value: settings[keys.auto_show] } %}
			<p class="st-field-desc">{{ __('When on, the secondary title is merged into the post title automatically on the front end using the title format above.', 'secondary-title') }}</p>
		{% endblock %}
	{% endembed %}

	{# Only Show in Main Post #}
	{% embed 'components/card.twig' with { title: __('Only show in main post', 'secondary-title'), icon: 'article', id: 'st-card-only-main' } %}
		{% block card_body %}
			{% include 'components/toggle.twig' with { name: keys.only_show_in_main_post, id: 'st-toggle-only-main', value: settings[keys.only_show_in_main_post] } %}
			<p class="st-field-desc">{{ __('Limit the secondary title to the main post (loop) only. Widgets and related-posts stay unaffected.', 'secondary-title') }}</p>
		{% endblock %}
	{% endembed %}

</div>
