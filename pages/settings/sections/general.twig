<div class="st-merge">
	<span class="st-merge__label">{{ __('Auto-merge', 'secondary-title') }}</span>
	{% include 'components/toggle.twig' with { name: keys.auto_show, id: 'st-toggle-auto-show', value: settings[keys.auto_show], on_label: __('On', 'secondary-title'), off_label: __('Off', 'secondary-title') } %}
	<span class="st-merge__desc">{{ __('Insert format below into post title automatically', 'secondary-title') }}</span>
</div>

<div class="st-format">
	<input type="text"
		id="st-field-title-format"
		name="{{ keys.title_format|e }}"
		value="{{ settings[keys.title_format]|e }}"
		class="st-format-input"
		placeholder="%secondary_title%: %title%"
		data-st-format-input
		data-st-preview-target="st-format-preview"
		autocomplete="off"
		spellcheck="false">

	<div class="st-format-row">
		<div class="st-format-row__chips">
			<button type="button" class="st-chipp" data-st-placeholder="%title%"><code>%title%</code></button>
			<button type="button" class="st-chipp" data-st-placeholder="%secondary_title%"><code>%secondary_title%</code></button>
		</div>
		<div class="st-format-row__presets">
			<button type="button" class="st-chipp st-chipp--alt" data-st-preset="%secondary_title%: %title%"><code>%secondary_title%: %title%</code></button>
			<button type="button" class="st-chipp st-chipp--alt" data-st-preset="%secondary_title% &mdash; %title%"><code>%secondary_title% &mdash; %title%</code></button>
			<button type="button" class="st-chipp st-chipp--alt" data-st-preset="%secondary_title%"><code>%secondary_title%</code></button>
		</div>
	</div>

	<div id="st-format-preview"
		class="st-preview"
		data-st-preview
		data-st-sample-title="{{ preview.sample_title|e }}"
		data-st-sample-secondary="{{ preview.sample_secondary_title|e }}"></div>
</div>

<div class="st-sep"></div>

<div class="st-rules">
	<div class="st-rule">
		<div class="st-rule__info">
			<label for="st-toggle-only-main">{{ __('Main post only', 'secondary-title') }}</label>
			<span>{{ __('Only replace in the primary post query', 'secondary-title') }}</span>
		</div>
		{% include 'components/toggle.twig' with { name: keys.only_show_in_main_post, id: 'st-toggle-only-main', value: settings[keys.only_show_in_main_post], on_label: __('On', 'secondary-title'), off_label: __('Off', 'secondary-title') } %}
	</div>
	<div class="st-rule">
		<div class="st-rule__info">
			<label for="st-field-post-types">{{ __('Post types', 'secondary-title') }}</label>
			<span>{{ __('Leave empty to enable on all', 'secondary-title') }}</span>
		</div>
		{% include 'fields/multi-select-searchable.twig' with { name: keys.post_types, id: 'st-field-post-types', options: post_types_options, selected: settings[keys.post_types], placeholder: __('All post types', 'secondary-title') } %}
	</div>
	<div class="st-rule">
		<div class="st-rule__info">
			<label for="st-field-categories">{{ __('Categories', 'secondary-title') }}</label>
			<span>{{ __('Leave empty to show in all', 'secondary-title') }}</span>
		</div>
		{% include 'fields/multi-select-searchable.twig' with { name: keys.categories, id: 'st-field-categories', options: categories_options, selected: settings[keys.categories], placeholder: __('All categories', 'secondary-title') } %}
	</div>
	<div class="st-rule">
		<div class="st-rule__info">
			<label for="st-field-post-ids">{{ __('Post IDs', 'secondary-title') }}</label>
			<span>{{ __('Comma-separated', 'secondary-title') }}</span>
		</div>
		{% include 'fields/text.twig' with { name: keys.post_ids, id: 'st-field-post-ids', value: settings[keys.post_ids]|default([])|join(', '), placeholder: '13, 71, 33' } %}
	</div>
</div>

<div class="st-sep"></div>

<div class="st-help">
	<div class="st-help__col">
		<p><strong>{{ __('Quick start', 'secondary-title') }}</strong></p>
		<ol>
			<li>{{ __('Edit a post, find Secondary Title in the sidebar or meta box.', 'secondary-title') }}</li>
			<li>{{ __('Enter a value and save.', 'secondary-title') }}</li>
		</ol>
		<p class="st-help__usage">
			<strong>{{ __('Shortcode', 'secondary-title') }}</strong> <code>[secondary_title]</code><br>
			<strong>{{ __('PHP', 'secondary-title') }}</strong> <code>the_secondary_title()</code><br>
			<strong>{{ __('Block', 'secondary-title') }}</strong> <em>{{ __('Block inserter', 'secondary-title') }}</em>
		</p>
	</div>
	<div class="st-help__col st-help__col--donate">
		<p>{{ __('Built by hand &mdash; no AI-generated code. Every line written, reviewed and tested manually.', 'secondary-title') }}</p>
		<a href="https://www.paypal.me/thaikolja/10" class="st-donate" target="_blank" rel="noopener noreferrer">{{ __('Donate via PayPal', 'secondary-title') }}</a>
	</div>
</div>
