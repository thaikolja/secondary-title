{# Combined card: Auto-merge toggle + Title format input + preview. #}
<div class="st-section">
	<div class="st-section__head">
		<span>{{ __('Auto-merge & Format', 'secondary-title') }}</span>
	</div>
	<div class="st-section__body">
		<div class="st-auto-row">
			{% include 'components/toggle.twig' with { name: keys.auto_show, id: 'st-toggle-auto-show', value: settings[keys.auto_show], on_label: __('On', 'secondary-title'), off_label: __('Off', 'secondary-title') } %}
			<span class="st-auto-desc">{{ __('Automatically merge the secondary title into the post title using the format below. Turn off for manual control via shortcode, block, or theme function.', 'secondary-title') }}</span>
		</div>

		<div class="st-format-area">
			{% include 'fields/format-with-preview.twig' with { name: keys.title_format, id: 'st-field-title-format', preview_id: 'st-format-preview', value: settings[keys.title_format] } %}

			<div class="st-presets">
				<span class="st-presets__label">{{ __('Presets', 'secondary-title') }}</span>
				<button type="button" class="st-preset" data-st-preset="%secondary_title%: %title%"><code>%secondary_title%: %title%</code></button>
				<button type="button" class="st-preset" data-st-preset="%secondary_title% &mdash; %title%"><code>%secondary_title% &mdash; %title%</code></button>
				<button type="button" class="st-preset" data-st-preset="%secondary_title%"><code>%secondary_title%</code></button>
			</div>
		</div>
	</div>
</div>

{# Card: Display Rules. #}
<div class="st-section">
	<div class="st-section__head">
		<span>{{ __('Display rules', 'secondary-title') }}</span>
	</div>
	<div class="st-section__body">
		<div class="st-rules-grid">
			<div class="st-rule">
				<div class="st-rule__label">
					{% include 'components/icon.twig' with { name: 'article', size: 13 } only %}
					<span>{{ __('Main post only', 'secondary-title') }}</span>
				</div>
				{% include 'components/toggle.twig' with { name: keys.only_show_in_main_post, id: 'st-toggle-only-main', value: settings[keys.only_show_in_main_post], on_label: __('On', 'secondary-title'), off_label: __('Off', 'secondary-title') } %}
			</div>

			<div class="st-rule">
				<div class="st-rule__label">
					{% include 'components/icon.twig' with { name: 'files', size: 13 } only %}
					<span>{{ __('Post types', 'secondary-title') }}</span>
				</div>
				{% include 'fields/multi-select-searchable.twig' with { name: keys.post_types, id: 'st-field-post-types', options: post_types_options, selected: settings[keys.post_types], placeholder: __('All post types', 'secondary-title') } %}
			</div>

			<div class="st-rule">
				<div class="st-rule__label">
					{% include 'components/icon.twig' with { name: 'folders', size: 13 } only %}
					<span>{{ __('Categories', 'secondary-title') }}</span>
				</div>
				{% include 'fields/multi-select-searchable.twig' with { name: keys.categories, id: 'st-field-categories', options: categories_options, selected: settings[keys.categories], placeholder: __('All categories', 'secondary-title') } %}
			</div>

			<div class="st-rule">
				<div class="st-rule__label">
					{% include 'components/icon.twig' with { name: 'list-numbers', size: 13 } only %}
					<span>{{ __('Post IDs', 'secondary-title') }}</span>
				</div>
				{% include 'fields/text.twig' with { name: keys.post_ids, id: 'st-field-post-ids', value: settings[keys.post_ids]|default([])|join(', '), placeholder: __('e.g. 13, 71, 33', 'secondary-title') } %}
			</div>
		</div>
	</div>
</div>
