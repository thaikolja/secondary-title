<div class="st-panel">
	<div class="st-panel__head">
		{% include 'components/icon.twig' with { name: 'question', size: 14 } only %}
		<span>{{ __('Quick start', 'secondary-title') }}</span>
	</div>
	<div class="st-panel__body">
		<ol class="st-side-list">
			<li>{{ __('Add a secondary title via the sidebar in the block editor or the meta box in the Classic Editor.', 'secondary-title') }}</li>
			<li>{{ __('Use <code>[secondary_title]</code> in your content or the Gutenberg block.', 'secondary-title')|raw }}</li>
			<li>{{ __('Call <code>the_secondary_title()</code> from your theme.', 'secondary-title') }}</li>
		</ol>
	</div>
</div>

<div class="st-panel">
	<div class="st-panel__head">
		{% include 'components/icon.twig' with { name: 'code', size: 14 } only %}
		<span>{{ __('Shortcode', 'secondary-title') }}</span>
	</div>
	<div class="st-panel__body">
		<pre class="st-code-block"><code>[secondary_title]</code></pre>
		<p>{{ __('Attributes:', 'secondary-title') }}</p>
		<ul class="st-side-ul">
			<li><code>post_id</code> &mdash; {{ __('post ID. Default: current.', 'secondary-title') }}</li>
			<li><code>allow_html</code> &mdash; {{ __('render HTML. Default: false.', 'secondary-title') }}</li>
		</ul>
		<p class="st-panel__more">
			<a href="https://docs.kolja-nolte.com/secondary-title/" target="_blank" rel="noopener noreferrer">{{ __('Full docs &rarr;', 'secondary-title') }}</a>
		</p>
	</div>
</div>

<div class="st-panel">
	<div class="st-panel__head">
		{% include 'components/icon.twig' with { name: 'heart', size: 14 } only %}
		<span>{{ __('Support', 'secondary-title') }}</span>
	</div>
	<div class="st-panel__body">
		<p><strong>{{ __('Built by hand', 'secondary-title') }}</strong></p>
		<p>{{ __('No AI-generated code. Every line is written, reviewed, and tested manually.', 'secondary-title') }}</p>
		<a href="https://www.paypal.me/thaikolja/10" class="st-cta" target="_blank" rel="noopener noreferrer">{{ __('Donate via PayPal', 'secondary-title') }}</a>
	</div>
</div>
